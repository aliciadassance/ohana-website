{
  "id": "blog_post",
  "label": "Blog Post",
  "repeatable": true,
  "json": {
    "Main": {
      "uid": { "type": "UID", "config": { "label": "UID" } },
      "title": { "type": "StructuredText", "config": { "label": "Title", "single": "heading1" } },
      "excerpt": { "type": "StructuredText", "config": { "label": "Excerpt", "multi": "paragraph" } },
      "cover_image": {
        "type": "Image",
        "config": {
          "label": "Cover Image",
          "constraint": { "width": 1200, "height": 630 },
          "thumbnails": [{ "name": "Card", "width": 800, "height": 450 }]
        }
      },
      "publish_date": { "type": "Date", "config": { "label": "Publish Date" } },
      "category": {
        "type": "Select",
        "config": {
          "label": "Category",
          "options": ["Surf Tips", "Travel & Morocco", "Camp Life", "Wellness & News"],
          "default_value": "Camp Life"
        }
      },
      "author": {
        "type": "Link",
        "config": { "label": "Author", "select": "document", "customtypes": ["author"] }
      }
    },
    "Body": {
      "body": {
        "type": "Slices",
        "fieldset": "Slice Zone",
        "config": {
          "choices": {
            "rich_text": { "type": "SharedSlice" },
            "image": { "type": "SharedSlice" },
            "quote_callout": { "type": "SharedSlice" },
            "video_embed": { "type": "SharedSlice" }
          }
        }
      }
    }
  }
}
