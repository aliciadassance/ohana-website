{
  "id": "author",
  "label": "Author",
  "repeatable": true,
  "json": {
    "Main": {
      "uid": { "type": "UID", "config": { "label": "UID", "placeholder": "e.g. yassin-aourir" } },
      "name": { "type": "Text", "config": { "label": "Name" } },
      "role": { "type": "Text", "config": { "label": "Role", "placeholder": "e.g. Head Coach & Founder" } },
      "bio": { "type": "StructuredText", "config": { "label": "Bio", "multi": "paragraph,strong,em,hyperlink" } },
      "photo": { "type": "Image", "config": { "label": "Photo", "constraint": { "width": 400, "height": 400 }, "thumbnails": [] } },
      "instagram": { "type": "Link", "config": { "label": "Instagram", "allowTargetBlank": true, "select": "web" } }
    }
  }
}
