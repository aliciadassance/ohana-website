{
  "id": "author",
  "label": "Author",
  "repeatable": true,
  "status": true,
  "format": "custom",
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": { "label": "UID" }
      },
      "name": {
        "type": "Text",
        "config": { "label": "Name", "placeholder": "" }
      },
      "role": {
        "type": "Text",
        "config": { "label": "Role", "placeholder": "e.g. Head Coach & Founder" }
      },
      "bio": {
        "type": "StructuredText",
        "config": {
          "label": "Bio",
          "placeholder": "",
          "multi": "paragraph,strong,em,hyperlink",
          "allowTargetBlank": true
        }
      },
      "photo": {
        "type": "Image",
        "config": { "label": "Photo", "constraint": {}, "thumbnails": [] }
      },
      "instagram": {
        "type": "Link",
        "config": {
          "label": "Instagram",
          "placeholder": "",
          "select": null,
          "allowTargetBlank": true,
          "allowText": false,
          "repeat": false
        }
      }
    }
  }
}
