# Resend — get your API key at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx

# The "from" address for booking notification emails.
# Must be a verified domain on your Resend account.
# Example: booking@ohanasurfmorocco.com
RESEND_FROM_EMAIL=booking@yourdomain.com

# The "from" address for guest confirmation emails.
# Can be the same domain, different sender name.
RESEND_FROM_CONFIRM=Ohana Surf Morocco <hello@yourdomain.com>
