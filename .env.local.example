# Resend — get your API key at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx

# The "from" address for booking notification emails.
# Must be a verified domain on your Resend account.
# Example: booking@ohana-surf-morocco.com
RESEND_FROM_EMAIL=booking@yourdomain.com

# The "from" address for guest confirmation emails.
# Can be the same domain, different sender name.
RESEND_FROM_CONFIRM=Ohana Surf Morocco <hello@yourdomain.com>

# Optional — admin inbox that receives booking notifications.
# Defaults to ohanasurfguiding@gmail.com if unset.
# RESEND_TO_EMAIL=ohanasurfguiding@gmail.com

# Search engine indexing. Set to "true" only when ready to launch the site
# publicly. Anything else (or unset) blocks all crawlers via robots.txt.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Optional — extra allowed Origin for /api/booking POST submissions.
# By default the route only accepts requests whose Origin matches the host.
# Set this if the form is embedded on a different domain.
# ALLOWED_ORIGIN=https://www.ohana-surf-morocco.com
